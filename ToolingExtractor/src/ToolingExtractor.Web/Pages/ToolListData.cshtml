@page
@model ToolingExtractor.Web.Pages.ToolListDataModel
@{
    ViewData["Title"] = "Tool List Data Extracted";
}

<div class="mb-4">
    <a class="text-sm text-accent hover:underline" href="/FilesProcessed">&larr; Back to Files Processed</a>
</div>

<h2 class="page-title mb-2">Tool List Data Extracted</h2>
<div id="fileMeta" class="file-meta-panel mb-4 hidden"></div>
<p id="toolCount" class="text-sm text-accent mb-4 hidden"></p>
<div id="exportBar" class="flex gap-2 mb-4 hidden">
    <a id="exportCsv" class="btn" href="#">Download CSV</a>
    <a id="exportExcel" class="btn" href="#">Download Excel</a>
</div>

<div class="table-wrap">
    <table class="w-full text-sm" id="toolsTable">
        <thead>
            <tr>
                <th>Tool No.</th>
                <th>Tool Name</th>
                <th>Consumable Tool Description</th>
                <th>Tool Supplier</th>
                <th>Tool Holder</th>
                <th>Tool Diameter (D1)</th>
                <th>Flute Length (L1)</th>
                <th>Tool Ext. Length (L2)</th>
                <th>Tool Corner Radius</th>
                <th>Arbor Description (or equivalent specs)</th>
                <th>Tool Path Time in Minutes</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
<p id="loadError" class="log-error text-sm mt-4 hidden"></p>

@section Scripts {
<script>
(function () {
  const params = new URLSearchParams(window.location.search);
  const hash = params.get('hash');
  const metaEl = document.getElementById('fileMeta');
  const toolCountEl = document.getElementById('toolCount');
  const exportBar = document.getElementById('exportBar');
  const exportCsv = document.getElementById('exportCsv');
  const exportExcel = document.getElementById('exportExcel');
  const tbody = document.querySelector('#toolsTable tbody');
  const errEl = document.getElementById('loadError');

  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;');
  }

  function displayValue(value) {
    if (value == null) return '#NA';
    var text = String(value).trim();
    return text.length ? text : '#NA';
  }

  function metaLine(label, value) {
    return '<div class="file-meta-row"><span class="file-meta-label">' + esc(label) + '</span> ' +
      '<span class="file-meta-value">' + esc(displayValue(value)) + '</span></div>';
  }

  function renderHeader(summary) {
    var filename = summary.sourceFile || summary.toolListId;
    metaEl.innerHTML =
      metaLine('Filename:', filename) +
      metaLine('Tool List No.:', summary.toolListNumber || summary.toolListId) +
      metaLine('Part name:', summary.partNumber) +
      metaLine('Work Centre:', summary.workcenter) +
      metaLine('Machine Model:', summary.machineModel) +
      metaLine('Project Code:', summary.projectCode) +
      metaLine('CAM Programmer :', summary.camProgrammer) +
      metaLine('Approved By :', summary.approvedBy) +
      metaLine('Tool Register By :', summary.toolRegisteredBy);
    metaEl.classList.remove('hidden');
  }

  if (!hash) {
    errEl.textContent = 'Missing file reference. Open a file from Files Processed.';
    errEl.classList.remove('hidden');
    return;
  }

  async function load() {
    await window.waitForDataReset();
    const res = await fetch('/api/files/' + encodeURIComponent(hash));
    if (!res.ok) {
      errEl.textContent = 'Could not load tooling data for this file.';
      errEl.classList.remove('hidden');
      return;
    }
    const data = await res.json();
    renderHeader(data.summary);

    const hashParam = encodeURIComponent(hash);
    exportCsv.href = '/api/export/csv?hash=' + hashParam;
    exportExcel.href = '/api/export/excel?hash=' + hashParam;
    exportBar.classList.remove('hidden');

    tbody.innerHTML = '';
    const toolRows = data.tools.filter(r =>
      r.toolNo && !(r.remarks && r.remarks.indexOf('PARSE_FAILED') >= 0));
    toolCountEl.textContent = toolRows.length + ' tool' + (toolRows.length === 1 ? '' : 's') + ' extracted';
    toolCountEl.classList.remove('hidden');

    for (const r of toolRows) {
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td>' + esc(r.toolNo) + '</td>' +
        '<td>' + esc(r.toolName) + '</td>' +
        '<td>' + esc(r.consumableToolDescription) + '</td>' +
        '<td>' + esc(r.toolSupplier) + '</td>' +
        '<td>' + esc(r.toolHolder) + '</td>' +
        '<td>' + esc(r.toolDiameterD1) + '</td>' +
        '<td>' + esc(r.fluteLengthL1) + '</td>' +
        '<td>' + esc(r.toolExtLengthL2) + '</td>' +
        '<td>' + esc(r.toolCornerRadius) + '</td>' +
        '<td>' + esc(r.arborDescription) + '</td>' +
        '<td>' + esc(r.toolPathTimeMinutes) + '</td>' +
        '<td>' + esc(r.remarks) + '</td>';
      tbody.appendChild(tr);
    }
    if (tbody.children.length === 0) {
      const failed = data.tools.find(r => r.remarks && r.remarks.indexOf('PARSE_FAILED') >= 0);
      errEl.textContent = failed
        ? 'Tool table was not parsed (header only). Run Extract again for this file.'
        : 'No tool rows stored for this file. Run Extract again for this file.';
      errEl.classList.remove('hidden');
    }
  }

  load();
})();
</script>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ToolingExtractor</title>
    <script src="~/js/te-session.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/app.css" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body class="te-app min-h-screen">
    <div class="flex min-h-screen">
        <aside class="te-sidebar w-56 p-6 flex flex-col gap-4">
            <h1 class="te-brand">ToolingExtractor</h1>
            <p class="te-version">v3.8.1</p>
            <nav class="flex flex-col gap-2 text-sm">
                <a class="te-nav-link" asp-page="/Index">Dashboard</a>
                <a class="te-nav-link" asp-page="/Extract">Extract</a>
                <a class="te-nav-link" asp-page="/FilesProcessed">Files Processed</a>
                <a class="te-nav-link" asp-page="/ExportAll">Export All</a>
            </nav>
        </aside>
        <main class="flex-1 p-8">
            @RenderBody()
        </main>
    </div>
    <script>
    window.waitForDataReset = function () {
      return window.__dataResetPromise ? window.__dataResetPromise : Promise.resolve();
    };

    document.querySelectorAll('aside nav a[href]').forEach(function (link) {
      link.addEventListener('click', function () {
        if (typeof window.teSaveWorkspace === 'function') {
          window.teSaveWorkspace();
        }
      });
    });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

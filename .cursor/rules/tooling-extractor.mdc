## CONFLICT RESOLUTION ENGINE — AMENDED PDF DETECTION

### IAmendmentDetector.cs
```csharp
public interface IAmendmentDetector
{
    AmendmentReport Inspect(string filePath);
}
```

### AmendmentDetector.cs — Full Implementation Specification

```csharp
public class AmendmentDetector : IAmendmentDetector
{
    // All thresholds injected from IOptions<ToolingExtractorOptions> — never hardcoded
    private readonly double _whiteColorThreshold;   // default 0.94
    private readonly double _coordProximityPt;       // default 5.0
    private readonly double _annotOverlapPt;         // default 8.0

    public AmendmentReport Inspect(string filePath)
    {
        var report = new AmendmentReport { FilePath = filePath };

        using var doc = PdfDocument.Open(filePath);

        foreach (var page in doc.GetPages())
        {
            var pageEvidence = new List<AmendmentEvidence>();

            var words = page.GetWords().ToList();

            // STEP 1: White-filled path shapes overlapping text
            var paths = page.ExperimentalAccess.GetPaths();
            foreach (var path in paths)
            {
                if (!path.IsFilled) continue;
                if (!IsNearWhite(path.FillColor)) continue;
                var pathBounds = GetPathBounds(path);
                if (pathBounds == null) continue;

                foreach (var word in words)
                {
                    if (BoundingBoxesOverlap(pathBounds.Value, word.BoundingBox))
                    {
                        pageEvidence.Add(new AmendmentEvidence
                        {
                            PageNumber   = page.Number,
                            EvidenceType = "WHITE_RECT_OVERLAP",
                            Detail = $"Page {page.Number}: white fill at " +
                                     $"[{pathBounds.Value.Left:F0},{pathBounds.Value.Bottom:F0}," +
                                     $"{pathBounds.Value.Right:F0},{pathBounds.Value.Top:F0}] " +
                                     $"overlaps text '{word.Text}'"
                        });
                    }
                }
            }

            // STEP 2: Duplicate characters at identical coordinates
            var letters = page.GetLetters().ToList();
            var grouped = letters
                .GroupBy(l => Math.Round(l.Location.Y / _coordProximityPt) * _coordProximityPt);

            foreach (var lineGroup in grouped)
            {
                var byX = lineGroup.GroupBy(
                    l => Math.Round(l.Location.X / _coordProximityPt) * _coordProximityPt);

                foreach (var xGroup in byX)
                {
                    var distinctChars = xGroup.Select(l => l.Value).Distinct().ToList();
                    if (distinctChars.Count > 1)
                    {
                        pageEvidence.Add(new AmendmentEvidence
                        {
                            PageNumber   = page.Number,
                            EvidenceType = "DUPLICATE_COORD",
                            Detail = $"Page {page.Number}: {distinctChars.Count} different " +
                                     $"chars at ({xGroup.Key:F0},{lineGroup.Key:F0}): " +
                                     $"[{string.Join(", ", distinctChars)}]"
                        });
                    }
                }
            }

            // STEP 3: Annotation overlays (FreeText, Stamp, Widget, Ink)
            var annotations = page.ExperimentalAccess.GetAnnotations();
            var overlayTypes = new[] { "FreeText", "Stamp", "Widget", "Ink" };
            foreach (var annotation in annotations)
            {
                if (!overlayTypes.Any(t => annotation.Type.ToString()
                    .Contains(t, StringComparison.OrdinalIgnoreCase))) continue;

                foreach (var word in words)
                {
                    if (BoundingBoxesOverlap(
                        annotation.Rectangle, word.BoundingBox, _annotOverlapPt))
                    {
                        pageEvidence.Add(new AmendmentEvidence
                        {
                            PageNumber   = page.Number,
                            EvidenceType = "ANNOTATION_OVERLAY",
                            Detail = $"Page {page.Number}: {annotation.Type} annotation " +
                                     $"overlaps text '{word.Text}'"
                        });
                    }
                }
            }

            if (pageEvidence.Count > 0)
            {
                report.Evidence.AddRange(pageEvidence);
                report.AffectedPageCount++;
            }
        }

        report.IsAmended = report.Evidence.Count > 0;
        report.Summary = report.IsAmended
            ? $"Amendment detected: {report.Evidence.Count} evidence item(s) across " +
              $"{report.AffectedPageCount} page(s). Types: " +
              $"{string.Join(", ", report.Evidence.Select(e => e.EvidenceType).Distinct())}"
            : "No amendment evidence found.";

        return report;
    }

    private bool IsNearWhite(IColor? color)
    {
        if (color == null) return false;
        if (color is RGBColor rgb)
            return rgb.R >= _whiteColorThreshold &&
                   rgb.G >= _whiteColorThreshold &&
                   rgb.B >= _whiteColorThreshold;
        if (color is GrayColor gray)
            return gray.GrayScale >= _whiteColorThreshold;
        if (color is CMYKColor cmyk)
            return cmyk.C <= (1 - _whiteColorThreshold) &&
                   cmyk.M <= (1 - _whiteColorThreshold) &&
                   cmyk.Y <= (1 - _whiteColorThreshold) &&
                   cmyk.K <= (1 - _whiteColorThreshold);
        return false;
    }

    private static PdfRectangle? GetPathBounds(IPath path)
    {
        try
        {
            var allPoints = path.Commands.OfType<IPathCommand>()
                .SelectMany(cmd => cmd switch
                {
                    Move m        => new[] { m.Location },
                    Line l        => new[] { l.From, l.To },
                    BezierCurve b => new[] { b.StartPoint, b.EndPoint },
                    _             => Array.Empty<PdfPoint>()
                }).ToList();
            if (!allPoints.Any()) return null;
            return new PdfRectangle(
                allPoints.Min(p => p.X), allPoints.Min(p => p.Y),
                allPoints.Max(p => p.X), allPoints.Max(p => p.Y));
        }
        catch { return null; }
    }

    private static bool BoundingBoxesOverlap(
        PdfRectangle a, PdfRectangle b, double tolerance = 2.0) =>
        a.Left < b.Right + tolerance && a.Right  > b.Left   - tolerance &&
        a.Bottom < b.Top + tolerance && a.Top    > b.Bottom - tolerance;
}
```

If `GetPaths()` or `GetAnnotations()` throws `NotSupportedException`, catch silently and
continue. If the entire Inspect call throws, return `IsAmended = false` with
`Summary = "Inspection failed: {ex.Message}"`. Never throw from this method.


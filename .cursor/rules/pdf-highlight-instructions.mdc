#### 5. JavaScript Implementation

```js
let currentHighlights = null;

const layerVisibility = {
    ocr: true,
    table: true,
    extracted: true,
    lowconf: true,
    ignored: true
};

async function loadHighlights(jobId, page) {
    const res = await fetch(`/api/extraction/${jobId}/visualizer/highlights?page=${page}`);
    currentHighlights = await res.json();
    redrawHighlights();
}

function redrawHighlights() {
    const img = document.getElementById('pdfImage');
    const canvas = document.getElementById('highlightCanvas');
    
    canvas.width = img.clientWidth;
    canvas.height = img.clientHeight;
    
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const scaleX = canvas.width;
    const scaleY = canvas.height;

    currentHighlights?.boxes?.forEach(box => {
        if (!layerVisibility[box.type]) return;

        const x = box.x * scaleX;
        const y = box.y * scaleY;
        const w = box.width * scaleX;
        const h = box.height * scaleY;

        let fillStyle = 'rgba(0,0,0,0)';
        let strokeStyle = 'rgba(0,0,0,0.6)';

        switch (box.type) {
            case 'ocr':
                fillStyle = 'rgba(0, 100, 255, 0.5)';      // Blue 50%
                strokeStyle = 'rgba(0, 80, 200, 0.8)';
                break;
            case 'table':
                fillStyle = 'rgba(100, 100, 100, 0.3)';    // Gray 30%
                strokeStyle = 'rgba(70, 70, 70, 0.7)';
                break;
            case 'extracted':
                fillStyle = 'rgba(0, 200, 100, 0.5)';      // Green 50%
                strokeStyle = 'rgba(0, 160, 80, 0.9)';
                break;
            case 'lowconf':
                fillStyle = 'rgba(255, 60, 60, 0.5)';      // Red 50%
                strokeStyle = 'rgba(200, 30, 30, 0.8)';
                break;
            case 'ignored':
                fillStyle = 'rgba(255, 220, 60, 0.2)';     // Yellow 20%
                strokeStyle = 'rgba(230, 180, 30, 0.5)';
                break;
        }

        ctx.fillStyle = fillStyle;
        ctx.strokeStyle = strokeStyle;
        ctx.lineWidth = 1.5;

        ctx.fillRect(x, y, w, h);
        ctx.strokeRect(x, y, w, h);
    });
}

// Attach toggle listeners
document.querySelectorAll('.layer-controls input').forEach(cb => {
    cb.addEventListener('change', (e) => {
        const type = e.target.id.replace('toggle-', '');
        layerVisibility[type] = e.target.checked;
        redrawHighlights();
    });
});

// Redraw on image load and resize
document.getElementById('pdfImage').onload = redrawHighlights;
window.addEventListener('resize', redrawHighlights);
```

